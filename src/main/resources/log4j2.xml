<?xml version="1.0" encoding="UTF-8"?>
<!--
  Log4j2 configuration (log4j-core is pinned to the vulnerable 2.14.1).

  DEMO-VULN: message-pattern lookups are LEFT ENABLED (no formatMsgNoLookups, no
  log4j2.formatMsgNoLookups system property). This is what makes StatusController's
  logging of the X-Api-Version header exploitable as Log4Shell (CVE-2021-44228).

  MITIGATION.md shows the non-upgrade control: setting
  LOG4J_FORMAT_MSG_NO_LOOKUPS=true (or %m{nolookups}) neutralizes the JNDI lookup
  WITHOUT bumping the log4j version.
-->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <!-- DEMO-VULN: %m (not %m{nolookups}) -> message lookups active. -->
            <PatternLayout pattern="%d{ISO8601} [%t] %-5level %logger{36} - %m%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="com.workforce.vms" level="info"/>
        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
