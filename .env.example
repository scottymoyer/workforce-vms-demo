# ── Copy to .env and fill in your Datadog sandbox key ────────────────────────
#   cp .env.example .env
# .env is git-ignored — never commit real keys.

# Required: Datadog API key (sandbox org).
DD_API_KEY=

# Datadog site. Examples: datadoghq.com (US1), datadoghq.eu, us5.datadoghq.com,
# us3.datadoghq.com, ap1.datadoghq.com
DD_SITE=datadoghq.com

# Unified Service Tagging (shown on every trace, signal, and finding).
DD_ENV=magnit-demo
DD_SERVICE=workforce-vms
DD_VERSION=1.0.0

# ── Source Code Integration (optional but recommended) ───────────────────────
# Lets Code Security findings deep-link to the exact file/line and PR.
# Fill these before `docker compose build`, e.g.:
#   DD_GIT_REPOSITORY_URL=github.com/your-org/workforce-vms-demo
#   DD_GIT_COMMIT_SHA=<git rev-parse HEAD>
DD_GIT_REPOSITORY_URL=
DD_GIT_COMMIT_SHA=

# ── CI only (NOT needed for local docker compose) ────────────────────────────
# Used by datadog-ci sbom upload / static analysis / quality gate in GitHub Actions.
# DD_APP_KEY=
